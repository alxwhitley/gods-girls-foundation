---
import Layout from "../layouts/Layout.astro";

const storyParagraphs = [
  "In 2018, Pam was diagnosed with breast cancer and underwent a single mastectomy. In recovery, she often went without a prosthesis at all — until a friend gave her one, hand-knitted by a local group of women. It was the best gift she'd received. It was also far from perfect.",
  "The wool shrank over time, leaving one side visibly larger than the other. It was uncomfortable, and more than once Pam found herself slipping away mid-service to adjust it — a harder thing to hide when she was the one ministering that day. She became self-conscious, certain people noticed what she couldn't fix.",
  "She wasn't alone in it. She saw the same struggle in women at church, in stores, in hospital waiting rooms. She recognized it most painfully in her own mother, who had faced breast cancer years earlier and used old, crumpled cloth in place of a real prosthesis — a quiet indignity that went unspoken but never unnoticed. At the time of her own diagnosis, Pam didn't know of a single shop that sold proper supplies. She'd heard of one, eventually, but the prices put it out of reach.",
  "Relief came through a woman she calls a friend to this day: a breast cancer survivor herself, serving as a missionary in Mombasa. Once a year, this woman opened her yard and sold prostheses, mastectomy bras, swimwear, and everything else a survivor might need. She taught Pam what to look for in a proper fit — soft seams, a wide underband that sits flat against the chest, deep front and side panels, full cups, wide adjustable straps, no underwire.",
  "For a few years, Pam bought her supplies from her and learned everything she could. It changed how she carried herself. She began introducing other survivors to the same source, and found real joy in watching their confidence return once they were properly fitted.",
  "Then the missionary's cancer returned, and she passed away. It was a loss felt widely — the women who had depended on her were left searching for a supplier that, in Kenya, barely existed. When supplies could be found at all, they were often unaffordable, and many women were still left making do with rags — visibly uneven, and impossible to hide.",
  "Pam couldn't unsee the gap that left behind. In 2023, after her own further treatment, her friend and sister Nneka Hay brought her to a mastectomy-supply store in Raleigh, North Carolina. Nneka explained the situation facing women back home in Kenya, and the store owner agreed to help gather donations.",
  "That was the moment God's Girls Foundation was born.",
];

const timeline = [
  {
    date: "2018",
    datetime: "2018",
    title: "Diagnosis and surgery",
    description: "Diagnosed with breast cancer; undergoes a single mastectomy.",
  },
  {
    date: "2018–2022",
    datetime: "2018/2022",
    title: "Living without proper fit",
    description:
      "Lives with an ill-fitting prosthesis; introduced to a Mombasa missionary who teaches her what proper fit means.",
    range: true,
  },
  {
    date: "2023",
    datetime: "2023",
    title: "A trip to Raleigh",
    description:
      "Travels to Raleigh, NC with Nneka Hay; a store owner agrees to gather donations. God's Girls Foundation is born.",
  },
  {
    date: "2026",
    datetime: "2026-07-14",
    title: "In memory",
    description: "Pam passes away on July 14, 2026.",
    final: true,
  },
];
---

<Layout
  title="About Pam Dreda Oyola — God's Girls Foundation"
  description="The story of Pam Dreda Oyola, founder of God's Girls Foundation, and why she started it."
>
  <section class="about-opening" aria-labelledby="about-name">
    <span class="about-mark" aria-hidden="true"></span>
    <h1 id="about-name" class="about-name">Pam Dreda Oyola</h1>
    <p class="about-dates">– 2026</p>
    <p class="about-role">Founder, God's Girls Foundation</p>
  </section>

  <section class="about-portrait" aria-labelledby="about-portrait-title">
    <figure class="founder-photo">
      <img
        src="/assets/founder-photo.jpg"
        alt="Portrait of Pam Dreda Oyola"
        width="1178"
        height="1178"
        loading="lazy"
      />
    </figure>
    <div class="about-portrait-copy">
      <h2 id="about-portrait-title" class="about-portrait-label">Introduction</h2>
      <p>
        Pam started God's Girls Foundation because she knew, firsthand, what it felt like to walk without dignity after surviving breast cancer. This is her story, in the words of the people who carry her mission forward.
      </p>
    </div>
  </section>

  <section class="about-narrative" aria-labelledby="about-narrative-title">
    <div class="about-narrative-head">
      <span class="about-narrative-rule" aria-hidden="true"></span>
      <span class="about-narrative-mark" aria-hidden="true"></span>
      <h2 id="about-narrative-title">Her story</h2>
    </div>
    <div class="about-narrative-body">
      {storyParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="about-timeline" aria-labelledby="about-timeline-title">
    <h2 id="about-timeline-title" class="visually-hidden">Timeline of Pam's story and the foundation's origin</h2>
    <ol class="story-path story-path--four">
      {timeline.map((item) => (
        <li>
          <time
            datetime={item.datetime}
            class:list={[{ "about-range-mark": item.range, "about-final-mark": item.final }]}
          >
            {item.range ? (
              <>
                2018–
                <br />
                2022
              </>
            ) : (
              item.date
            )}
          </time>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="about-tribute" aria-labelledby="about-tribute-line">
    <h2 id="about-tribute-line" class="about-tribute-line">Carry Her Mission Forward</h2>
    <p class="about-tribute-body">
      Pam didn't set out to build an institution. She set out to make sure no woman has to hide her dignity again. God's Girls Foundation continues that work in her name.
    </p>
    <div class="about-tribute-cta">
      <button type="button" class="primary-action" disabled aria-disabled="true">Donate in her memory</button>
      <p class="about-tribute-note">Donation link coming soon.</p>
    </div>
  </section>
</Layout>

<script>
  const cta = document.querySelector(".about-tribute-cta");

  if (cta) {
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              cta.classList.add("is-visible");
              obs.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      observer.observe(cta);
    } else {
      cta.classList.add("is-visible");
    }
  }
</script>
